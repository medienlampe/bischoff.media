---
permalink: ror.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:ror="http://rorweb.com/0.1/">
<channel>
  <title>ROR Sitemap for {{ site.url }}/</title>
  <link>{{ site.url }}/</link>
{%- for item in collections.indexable %}
<item>
     <link>{{ site.url }}{{ item.url }}</link>
     <title>{{ item.data.title }}</title>
     <description>{{ item.data.description }}</description>
     <ror:updatePeriod>monthly</ror:updatePeriod>
     <ror:sortOrder>{{ loop.index0 }}</ror:sortOrder>
     <ror:resourceOf>sitemap</ror:resourceOf>
</item>
{%- endfor %}
</channel>
</rss>
