<!DOCTYPE html>
<html lang="en">
  {% include "templates/header.en.njk" %}
  <body>
    <a href="#main" class="skip-link">Jump to main content</a>
    <main id="main" class="h-card">
      <h1 class="p-name">{{ note | safe }}</h1>
      <h2 class="p-note">
        {{ name | safe}}
      </h2>
      <a href="/english.html" title="Go to homepage">
        <img
          class="u-photo"
          width="333"
          height="333"
          alt="Photo of Sven Bischoff, Senior Engineering Manager in Leipzig"
          src="/assets/img/sb.webp"
        />
      </a>
      <section id="welcome">
        {{ content | safe }}
      </section>
    </main>
    {% include "templates/footer.en.njk" %}
  </body>
</html>

