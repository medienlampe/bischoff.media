<!DOCTYPE html>
<html lang="de">
  {% include "templates/header.njk" %}
  <body>
    <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>
    <main id="main" class="h-card">
      <h1 class="p-name">{{ note | safe }}</h1>
      <h2 class="p-note">
        {{ name | safe}}
      </h2>
      <a href="/" title="Zurück zur Hauptseite"
        ><img
          class="u-photo"
          width="333"
          height="333"
          fetchpriority="high"
          alt="Foto von Sven Bischoff, Senior Engineering Manager in Leipzig"
          src="/assets/img/sb.webp"
      /></a>
      <section id="welcome">
        {{ content | safe }}
      </section>
    </main>
    {% include "templates/footer.njk" %}
  </body>
</html>



