{% set navPages = navPages %}
<footer class="site-footer">
  <nav class="container footer-nav" aria-label="{{ "Rechtliches und Sprache" if lang == "de" else "Legal and language" }}">
  {%- for entry in navPages %}
    {% if entry.url == page.url %}
      <strong{% if entry.lang %} lang="{{ entry.lang }}"{% endif %} aria-current="page">{{ entry.title }}</strong>
    {% else %}
      <a href="{{ entry.url }}"{% if entry.lang %} lang="{{ entry.lang }}" hreflang="{{ entry.lang }}"{% endif %}>{{ entry.title }}</a>
    {% endif %}
  {%- endfor %}
  </nav>
</footer>