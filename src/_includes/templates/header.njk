<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="preload" href="./assets/css/app.css" as="style">
  <link rel="stylesheet" href="./assets/css/app.css">
  <link rel="author" href="./humans.txt" />
  <link rel="authorization_endpoint" href="https://indieauth.com/auth" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <title>{{ title }}</title>
  <meta
    name="description"
    content="{{ description | default(site.description) }}"
  />
  {% if noindex %}
  <meta name="robots" content="noindex, follow" />
  {% endif %}
  {% if alternateUrl %}
  <link rel="alternate" hreflang="de" href="{{ site.url }}/" />
  <link rel="alternate" hreflang="en" href="{{ site.url }}/english.html" />
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/" />
  {% endif %}
  <meta name="theme-color" content="#37474f" />
  <link rel="apple-touch-icon" href="./assets/pwa/a4db7015-2abf-ca0f-2514-44c4f7133fe3.webPlatform.png">
  <link rel="manifest" href="./manifest.json" />
  <link rel="shortcut icon" href="./assets/img/favicon.png" />

  <meta property="og:type" content="profile" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:locale" content="de_DE" />
  {% if alternateUrl %}<meta property="og:locale:alternate" content="en_US" />{% endif %}
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description | default(site.description) }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}{{ site.image }}" />
  <meta property="og:image:width" content="333" />
  <meta property="og:image:height" content="333" />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description | default(site.description) }}" />
  <meta name="twitter:image" content="{{ site.url }}{{ site.image }}" />

  {% if alternateUrl %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Sven Bischoff",
    "url": "{{ site.url }}/",
    "image": "{{ site.url }}{{ site.image }}",
    "jobTitle": "Senior Engineering Manager",
    "worksFor": {
      "@type": "Organization",
      "name": "Invia Travel Germany GmbH",
      "url": "https://www.invia.de"
    },
    "sameAs": {{ site.sameAs | dump | safe }}
  }
  </script>
  {% endif %}
</head>
